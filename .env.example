DISCORD_TOKEN=

# Discord user id allowed to run /stock buy and /stock sell. Leave unset to
# disable trading for everyone.
OWNER_ID=

DATABASE_URL=

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=

# Webull OpenAPI (TH). WEBULL_ACCESS_TOKEN is optional: if unset (and OWNER_ID is
# set), the bot issues a token on startup and DMs the owner the SMS 2FA steps to
# complete in the Webull app. Set it to pin a known-good NORMAL token instead.
# WEBULL_BASE_URL defaults to production (use
# https://th-api.uat.webullbroker.com for UAT, which auto-activates tokens).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_BASE_URL=
# Account to trade in; defaults to the first account on the token when unset.
WEBULL_ACCOUNT_ID=
